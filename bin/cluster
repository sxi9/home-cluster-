#!/usr/bin/env python3
"""cluster: run one GGUF model across every awake device.

  cluster nodes                       who is awake, what they offer
  cluster run MODEL.gguf [options]    plan the split, start llama-server
  cluster plan MODEL.gguf [options]   same, print the plan only
  cluster status                      current run + throughput
  cluster stop                        stop llama-server
  cluster logs [-f]                   llama-server log
  cluster ui [stop]                   Open WebUI on k3s, pointed at this cluster
  cluster models                      GGUFs in the share, with size and fit
  cluster exec NODE|--all -- CMD      run a command on devices over ssh (one controller)
  cluster restart [NODE|--all]        restart rpc-server + agent on devices
  cluster ssh NODE                    interactive shell on a device
  cluster top [NODE]                  process manager: top processes per device, alerts
  cluster kill NODE PID               kill a process on a device (over ssh)
  cluster share [--public|off]        dashboard + Open WebUI over Tailscale (or the internet)
  cluster bench [--model S.gguf] [NODE|--all]
                                      measure every device: tok/s over RPC, link RTT and
                                      bandwidth; finds the slowest device; feeds the planner
  cluster tune [KEY=VALUE ...]        show / set optimization settings (flash attention,
                                      KV cache type, batch sizes, threads, draft params...)

run/plan options:
  --ctx N            context size (default 8192)
  --port N           llama-server port (default LLAMA_PORT, 8080)
  --only a,b         use only these nodes      --exclude a,b   skip these nodes
  --no-head-gpu      leave the head's GPU out  --cpu-only      only CPU workers
  --margin PCT       keep this much of each device's memory free (default 12)
  --wifi             allow Wi-Fi devices (default: only if needed to fit)
  --draft SMALL.gguf speculative decoding: a small draft model on the head
                     proposes tokens, the big split model only verifies them.
                     The biggest tokens/sec win on a slow RPC chain.
  --                 everything after is passed to llama-server

How the split works: llama.cpp's RPC backend splits the model by layers across
devices, in the order given. Every token walks through every device, so the
planner fills the fastest devices first (head GPU, wired GPU, wired CPU, Wi-Fi)
and only reaches for the slow ones when the model does not fit otherwise.
Layers that fit nowhere stay on the head's CPU RAM.
"""
import json
import os
import re
import signal
import struct
import subprocess
import sys
import time
import urllib.request

ENV_FILE = os.environ.get("CLUSTER_ENV", "/etc/home-cluster/head.env")


def read_env(path):
    env = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    env[k.strip()] = v.strip()
    except OSError:
        pass
    return env


ENV = read_env(ENV_FILE)
cfg = lambda k, d=None: os.environ.get(k) or ENV.get(k) or d
ROOT = cfg("CLUSTER_ROOT", "/srv/cluster")
STATE = cfg("STATE_DIR", os.path.join(ROOT, "state"))
LOGS = cfg("LOG_DIR", os.path.join(ROOT, "logs"))
MODELS = cfg("MODELS_DIR", os.path.join(ROOT, "models"))
LLAMA_BIN = cfg("LLAMA_BIN", "/opt/llama.cpp/bin")
CLUSTERD = "http://127.0.0.1:%s" % cfg("CLUSTERD_PORT", "8787")
RUN_FILE = os.path.join(STATE, "run.json")
BENCH_FILE = os.path.join(STATE, "bench.json")
TUNING_FILE = cfg("TUNING_FILE", os.path.join(os.path.dirname(ENV_FILE), "tuning.env"))

# optimization settings: key -> (default, help). `cluster tune` edits them; `cluster run` applies them.
TUNING = {
    "CTX":            ("8192",  "default context size"),
    "FLASH_ATTN":     ("auto",  "on|off|auto  flash attention (faster, less memory on GPU)"),
    "KV_CACHE_TYPE":  ("f16",   "f16|q8_0|q4_0  KV cache precision; q8_0 halves its memory"),
    "BATCH":          ("2048",  "logical batch size (-b); prompt processing throughput"),
    "UBATCH":         ("512",   "physical batch size (-ub); lower if a device runs out of memory"),
    "THREADS":        ("auto",  "head CPU threads for the layers that stay on the head"),
    "MLOCK":          ("off",   "on|off  lock the head's model pages in RAM (no swapping)"),
    "NO_MMAP":        ("off",   "on|off  read the model instead of mmap (helps slow NFS/disks)"),
    "MARGIN_PCT":     ("12",    "memory kept free on every device for compute buffers"),
    "WIFI_MAX_PCT":   ("30",    "at most this percent of layers on Wi-Fi devices"),
    "ORDER":          ("bench", "bench|heuristic  device order: measured speed, or link/gpu heuristic"),
    "DRAFT_MAX":      ("16",    "speculative decoding: tokens the draft proposes per step"),
    "DRAFT_MIN":      ("4",     "speculative decoding: minimum draft tokens"),
    "DRAFT_P_MIN":    ("0.8",   "speculative decoding: min draft probability"),
}


def load_tuning():
    t = {k: v[0] for k, v in TUNING.items()}
    t.update({k: v for k, v in read_env(TUNING_FILE).items() if k in TUNING})
    return t


def load_bench():
    try:
        with open(BENCH_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}
LOG_FILE = os.path.join(LOGS, "llama-server.log")

C = {"b": "\033[1m", "g": "\033[32m", "y": "\033[33m", "r": "\033[31m", "d": "\033[2m", "0": "\033[0m"}
if not sys.stdout.isatty():
    C = {k: "" for k in C}


def die(msg):
    print(C["r"] + "error: " + C["0"] + msg, file=sys.stderr)
    sys.exit(1)


def gb(mb):
    if mb is None:
        return "-"
    return "%d MB" % mb if mb < 1024 else "%.1f GB" % (mb / 1024)


def get_json(url, timeout=3):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.load(r)


# ---------------------------------------------------------------------------
# GGUF header: enough metadata to plan the split
# ---------------------------------------------------------------------------
def read_gguf(path):
    """Return dict with arch, name, n_layer, n_embd, n_head, n_head_kv, size_mb."""
    types = {0: "B", 1: "b", 2: "H", 3: "h", 4: "I", 5: "i", 6: "f", 7: "?", 10: "Q", 11: "q", 12: "d"}
    meta = {}
    with open(path, "rb") as f:
        if f.read(4) != b"GGUF":
            die("%s is not a GGUF file" % path)
        version, = struct.unpack("<I", f.read(4))
        if version < 2:
            die("GGUF v%d is too old" % version)
        n_tensors, n_kv = struct.unpack("<QQ", f.read(16))

        def rstr():
            n, = struct.unpack("<Q", f.read(8))
            return f.read(n).decode("utf-8", "replace")

        def rval(t):
            if t == 8:
                return rstr()
            if t == 9:
                et, = struct.unpack("<I", f.read(4))
                n, = struct.unpack("<Q", f.read(8))
                if et in types:
                    sz = struct.calcsize(types[et])
                    f.seek(n * sz, 1)
                    return None
                for _ in range(n):
                    rval(et)
                return None
            fmt = types[t]
            return struct.unpack("<" + fmt, f.read(struct.calcsize(fmt)))[0]

        for _ in range(n_kv):
            key = rstr()
            t, = struct.unpack("<I", f.read(4))
            if key.startswith("tokenizer."):
                break  # everything we need comes before the tokenizer
            meta[key] = rval(t)
    arch = meta.get("general.architecture", "llama")
    g = lambda k, d=None: meta.get("%s.%s" % (arch, k), d)
    n_head = g("attention.head_count", 32) or 32
    return {
        "arch": arch,
        "name": meta.get("general.name") or os.path.basename(path),
        "n_layer": int(g("block_count", 0) or 0),
        "n_embd": int(g("embedding_length", 4096) or 4096),
        "n_head": int(n_head),
        "n_head_kv": int(g("attention.head_count_kv", n_head) or n_head),
        "size_mb": os.path.getsize(path) // 2**20,
        "n_tensors": n_tensors,
    }


# ---------------------------------------------------------------------------
# devices
# ---------------------------------------------------------------------------
def head_devices():
    """Local (non-RPC) devices llama.cpp sees on the head, from --list-devices."""
    exe = os.path.join(LLAMA_BIN, "llama-server")
    try:
        out = subprocess.run([exe, "--list-devices"], capture_output=True, text=True, timeout=20)
        text = out.stdout + out.stderr
    except (OSError, subprocess.SubprocessError):
        return []
    devs = []
    for m in re.finditer(r"^\s+(\S+):\s+(.*?)\s+\((\d+)\s+MiB,\s+(\d+)\s+MiB free\)", text, re.M):
        name, desc, total, free = m.groups()
        if name.upper().startswith("CPU"):
            continue
        devs.append({"device": name, "node": cfg("NODE_NAME", "head"), "desc": desc, "link": "local",
                     "gpu": name.rstrip("0123456789").lower(), "offered_mb": int(free), "total_mb": int(total)})
    return devs


def offered_mb(n):
    g = n.get("gpu") or {}
    if g.get("vram_free_mb") is not None and not g.get("unified"):
        return int(g["vram_free_mb"])
    free = int((n.get("mem") or {}).get("free_mb") or 0)
    cap = int((n.get("rpc") or {}).get("mem_mb") or 0)
    return min(free, cap) if cap else free


def fresh(n):
    """Re-poll a node's agent so we plan on current free memory, not a 10 s old heartbeat."""
    if not n.get("agent_port"):
        return n          # heartbeat-only agent (Windows)
    try:
        m = get_json("http://%s:%s/metrics" % (n.get("lan_ip"), n.get("agent_port", 8788)), timeout=2)
        if m.get("name") != n.get("name"):
            return n          # someone else answered on that address; trust the heartbeat
        m["awake"] = True
        return m
    except Exception:
        return n


def worker_devices(only=None, exclude=None, wifi=True, cpu_only=False):
    try:
        nodes = get_json(CLUSTERD + "/api/nodes")
    except Exception as e:
        die("clusterd not reachable at %s (%s). Is clusterd.service running on the head?" % (CLUSTERD, e))
    devs = []
    for n in nodes:
        if n.get("role") == "head" or not n.get("awake"):
            continue
        if only and n["name"] not in only:
            continue
        if exclude and n["name"] in exclude:
            continue
        n = fresh(n)
        if not (n.get("rpc") or {}).get("listening"):
            continue
        gpu = (n.get("gpu") or {}).get("kind", "cpu")
        if cpu_only and gpu != "cpu":
            continue
        devs.append({"device": "RPC[%s:%s]" % (n["lan_ip"], n["rpc"]["port"]), "node": n["name"],
                     "link": n.get("link", "unknown"), "gpu": gpu, "offered_mb": offered_mb(n),
                     "temp_c": n.get("temp_c"), "rpc": "%s:%s" % (n["lan_ip"], n["rpc"]["port"])})
    rank = {"wired": 0, "unknown": 1, "wifi": 2}
    devs.sort(key=lambda d: (rank.get(d["link"], 1), d["gpu"] == "cpu", -d["offered_mb"]))
    bench = load_bench()
    if load_tuning()["ORDER"] == "bench" and any(d["node"] in bench for d in devs):
        # measured speed wins over the heuristic: fastest device first, unmeasured ones last
        for d in devs:
            b = bench.get(d["node"]) or {}
            d["tg_tps"] = b.get("tg_tps")
        devs.sort(key=lambda d: -(d.get("tg_tps") or 0))
    return devs


# ---------------------------------------------------------------------------
# planner
# ---------------------------------------------------------------------------
def plan(model_path, ctx=8192, margin=12, only=None, exclude=None, head_gpu=True, cpu_only=False, wifi=None):
    tuning = load_tuning()
    info = read_gguf(model_path)
    if not info["n_layer"]:
        die("could not read block_count from %s" % model_path)
    head_dim = info["n_embd"] // max(info["n_head"], 1)
    kv_mb = 2 * info["n_head_kv"] * head_dim * 2 * ctx * info["n_layer"] / 2**20  # f16 K and V
    per_layer = (info["size_mb"] + kv_mb) / info["n_layer"] * 1.08                # + compute buffers
    need_mb = per_layer * info["n_layer"]

    devs = (head_devices() if head_gpu and not cpu_only else []) + \
           worker_devices(only, exclude, cpu_only=cpu_only)
    wired = [d for d in devs if d["link"] != "wifi"]
    wifi_devs = [d for d in devs if d["link"] == "wifi"]
    cap = lambda d: int(d["offered_mb"] * (1 - margin / 100) // per_layer)
    order = wired
    if wifi or sum(cap(d) for d in wired) < info["n_layer"]:
        order = wired + wifi_devs    # reach for Wi-Fi only when needed, or asked
    assigned, start = [], 0
    wifi_budget = int(info["n_layer"] * float(tuning["WIFI_MAX_PCT"]) / 100)
    for d in order:
        n = min(cap(d), info["n_layer"] - start)
        if d["link"] == "wifi":
            n = min(n, wifi_budget)       # a Wi-Fi device must not hold most of the chain
            wifi_budget -= max(n, 0)
        if n <= 0:
            continue
        assigned.append({**d, "layers": [start, start + n], "split": n})
        start += n
        if start >= info["n_layer"]:
            break
    ngl = start
    left = info["n_layer"] - ngl
    head_free = None
    try:
        hm = get_json("http://127.0.0.1:%s/metrics" % cfg("AGENT_PORT", "8788"), timeout=2)
        head_free = hm["mem"]["free_mb"]
    except Exception:
        try:
            with open("/proc/meminfo") as f:
                head_free = int([l for l in f if l.startswith("MemAvailable")][0].split()[1]) // 1024
        except Exception:
            pass
    fits = True
    if left:
        need_head = left * per_layer
        fits = head_free is None or need_head < head_free * (1 - margin / 100)
        assigned.append({"device": "CPU", "node": cfg("NODE_NAME", "head"), "link": "local", "gpu": "cpu",
                         "offered_mb": head_free, "layers": [ngl, info["n_layer"]], "split": None})
    return {
        "model": info["name"], "model_path": os.path.abspath(model_path), "arch": info["arch"],
        "size_mb": info["size_mb"], "n_layer": info["n_layer"], "ctx": ctx, "kv_mb": int(kv_mb),
        "per_layer_mb": int(per_layer), "need_mb": int(need_mb), "ngl": ngl, "fits": fits,
        "devices": assigned, "margin": margin, "tuning": tuning,
        "bench": {d["node"]: load_bench().get(d["node"]) for d in assigned if load_bench().get(d["node"])},
        "unused": [d["node"] for d in devs if d["node"] not in {a["node"] for a in assigned}],
    }


def print_plan(p):
    print(C["b"] + p["model"] + C["0"] + "  %s on disk · %d layers · ctx %d · ~%s KV cache · ~%s per layer"
          % (gb(p["size_mb"]), p["n_layer"], p["ctx"], gb(p["kv_mb"]), gb(p["per_layer_mb"])))
    print("  %-22s %-8s %-6s %-10s %-8s %s" % ("device", "link", "gpu", "offers", "layers", "range"))
    for d in p["devices"]:
        n = d["layers"][1] - d["layers"][0]
        print("  %-22s %-8s %-6s %-10s %-8d %d-%d" % (d["node"], d["link"], d["gpu"], gb(d["offered_mb"]), n,
                                                     d["layers"][0], d["layers"][1] - 1))
    if p["unused"]:
        print(C["d"] + "  not needed: " + ", ".join(p["unused"]) + C["0"])
    if p.get("draft"):
        print("  speculative decoding with draft model %s on the head" % p["draft"])
    b = p.get("bench") or {}
    if b:
        slow = min(b, key=lambda k: b[k].get("tg_tps") or 1e9)
        print("  measured: " + ", ".join("%s %.1f tok/s" % (k, v.get("tg_tps") or 0) for k, v in b.items())
              + C["y"] + "  · bottleneck: %s" % slow + C["0"])
    t = p.get("tuning") or {}
    on = [k for k in ("FLASH_ATTN", "KV_CACHE_TYPE", "MLOCK", "NO_MMAP") if t.get(k) not in (None, "off", "auto", "f16")]
    if on:
        print("  tuning: " + ", ".join("%s=%s" % (k, t[k]) for k in on))
    if p["ngl"] < p["n_layer"]:
        print(C["y"] + "  %d layer(s) stay on the head's CPU RAM" % (p["n_layer"] - p["ngl"]) + C["0"])
    if not p["fits"]:
        print(C["r"] + "  does not fit: need ~%s, wake more devices or pick a smaller quant" % gb(p["need_mb"]) + C["0"])


_HELP = None


def server_has(flag):
    """Does this llama-server know a flag? (names changed across versions)"""
    global _HELP
    if _HELP is None:
        try:
            r = subprocess.run([os.path.join(LLAMA_BIN, "llama-server"), "--help"], capture_output=True, text=True, timeout=20)
            _HELP = r.stdout + r.stderr
        except (OSError, subprocess.SubprocessError):
            _HELP = ""
    return flag in _HELP


def rpc_device_names(rpc_list):
    """host:port -> device name as this llama-server calls it (RPC0.. on current builds,
    RPC[host:port] on older ones). Asks --list-devices with the same --rpc list."""
    names = {}
    exe = os.path.join(LLAMA_BIN, "llama-server")
    try:
        r = subprocess.run([exe, "--rpc", ",".join(rpc_list), "--list-devices"], capture_output=True, text=True, timeout=30)
        for m in re.finditer(r"^\s+(\S+):\s+(.*?)\s+\(\d+\s+MiB", r.stdout + r.stderr, re.M):
            name, desc = m.groups()
            if desc in rpc_list:
                names[desc] = name
            elif name.startswith("RPC[") and name[4:-1] in rpc_list:
                names[name[4:-1]] = name
    except (OSError, subprocess.SubprocessError):
        pass
    for i, hp in enumerate(rpc_list):
        names.setdefault(hp, "RPC%d" % i)
    return names


def build_cmd(p, port, extra):
    rpc = [d for d in p["devices"] if d.get("rpc")]
    if rpc:
        names = rpc_device_names([d["rpc"] for d in rpc])
        for d in rpc:
            d["device"] = names[d["rpc"]]
    devs = [d["device"] for d in p["devices"] if d["device"] != "CPU"]
    cmd = [os.path.join(LLAMA_BIN, "llama-server"), "-m", p["model_path"], "--host", "0.0.0.0", "--port", str(port),
           "--metrics", "-c", str(p["ctx"]), "-ngl", str(p["ngl"]), "--alias", p["model"]]
    if rpc:
        cmd += ["--rpc", ",".join(d["rpc"] for d in rpc)]
    if devs:
        cmd += ["--device", ",".join(devs)]
    if len(devs) > 1:
        cmd += ["--tensor-split", ",".join(str(d["split"]) for d in p["devices"] if d["device"] != "CPU")]
    t = p.get("tuning") or load_tuning()
    if t["FLASH_ATTN"] in ("on", "off"):
        cmd += ["-fa", t["FLASH_ATTN"]]
    if t["KV_CACHE_TYPE"] != "f16":
        cmd += ["-ctk", t["KV_CACHE_TYPE"], "-ctv", t["KV_CACHE_TYPE"]]
    cmd += ["-b", t["BATCH"], "-ub", t["UBATCH"]]
    if t["THREADS"] != "auto":
        cmd += ["-t", t["THREADS"]]
    if server_has("--load-mode"):
        if t["MLOCK"] == "on":
            cmd += ["--load-mode", "mlock"]
        elif t["NO_MMAP"] == "on":
            cmd += ["--load-mode", "none"]
    else:
        if t["MLOCK"] == "on":
            cmd += ["--mlock"]
        if t["NO_MMAP"] == "on":
            cmd += ["--no-mmap"]
    if p.get("draft_path"):
        # the draft model stays entirely on the head: its whole point is to avoid the network
        head_gpu = [d["device"] for d in p["devices"] if d["link"] == "local" and d["device"] != "CPU"]
        new = server_has("--spec-draft-n-max")
        cmd += ["-md", p["draft_path"], "--spec-draft-n-max" if new else "--draft-max", t["DRAFT_MAX"],
                "--spec-draft-n-min" if new else "--draft-min", t["DRAFT_MIN"], "--draft-p-min", t["DRAFT_P_MIN"]]
        cmd += ["-ngld", "999", "--device-draft", head_gpu[0]] if head_gpu else ["-ngld", "0"]
    return cmd + list(extra)


# ---------------------------------------------------------------------------
# run lifecycle
# ---------------------------------------------------------------------------
def save_run(run):
    os.makedirs(STATE, exist_ok=True)
    tmp = RUN_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(run, f, indent=1)
    os.replace(tmp, RUN_FILE)


def load_run():
    try:
        with open(RUN_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def cmd_run(args, dry=False):
    tuning = load_tuning()
    opts = {"ctx": int(tuning["CTX"]), "port": int(cfg("LLAMA_PORT", "8080")), "only": None, "exclude": None,
            "head_gpu": True, "cpu_only": False, "margin": float(tuning["MARGIN_PCT"]), "wifi": None, "draft": None}
    extra, model = [], None
    it = iter(args)
    for a in it:
        if a == "--":
            extra = list(it)
        elif a == "--ctx":
            opts["ctx"] = int(next(it))
        elif a == "--port":
            opts["port"] = int(next(it))
        elif a == "--only":
            opts["only"] = set(next(it).split(","))
        elif a == "--exclude":
            opts["exclude"] = set(next(it).split(","))
        elif a == "--margin":
            opts["margin"] = float(next(it))
        elif a == "--no-head-gpu":
            opts["head_gpu"] = False
        elif a == "--cpu-only":
            opts["cpu_only"] = True
        elif a == "--wifi":
            opts["wifi"] = True
        elif a == "--draft":
            opts["draft"] = next(it)
        elif a.startswith("-"):
            die("unknown option %s" % a)
        else:
            model = a
    if not model:
        die("usage: cluster run MODEL.gguf [options]")
    if not os.path.exists(model) and os.path.exists(os.path.join(MODELS, model)):
        model = os.path.join(MODELS, model)
    if not os.path.exists(model):
        die("%s not found (looked in %s too)" % (model, MODELS))
    p = plan(model, opts["ctx"], opts["margin"], opts["only"], opts["exclude"], opts["head_gpu"], opts["cpu_only"], opts["wifi"])
    if opts["draft"]:
        d = opts["draft"]
        if not os.path.exists(d) and os.path.exists(os.path.join(MODELS, d)):
            d = os.path.join(MODELS, d)
        if not os.path.exists(d):
            die("draft model %s not found" % opts["draft"])
        p["draft"] = read_gguf(d)["name"]
        p["draft_path"] = os.path.abspath(d)
        print("  draft model: %s (runs on the head%s)" % (p["draft"], ", GPU" if any(x["device"] != "CPU" and x["link"] == "local" for x in p["devices"]) else ""))
    print_plan(p)
    cmd = build_cmd(p, opts["port"], extra)
    print(C["d"] + "  " + " ".join(cmd) + C["0"])
    if dry:
        return
    if not p["fits"]:
        die("refusing to start, the model does not fit")
    old = load_run()
    if old and old.get("pid") and alive(old["pid"]):
        die("a run is already active (pid %d): cluster stop first" % old["pid"])
    import socket
    try:
        with socket.create_connection(("127.0.0.1", opts["port"]), timeout=1):
            die("port %d is already in use by something else; stop it or use --port" % opts["port"])
    except OSError:
        pass
    os.makedirs(LOGS, exist_ok=True)
    log = open(LOG_FILE, "wb")
    proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    run = {**p, "pid": proc.pid, "port": opts["port"], "cmd": cmd, "started": time.time(), "status": "loading",
           "log": LOG_FILE}
    save_run(run)
    print("loading (pid %d), log: %s" % (proc.pid, LOG_FILE))
    url = "http://127.0.0.1:%d" % opts["port"]
    deadline = time.time() + 900
    while time.time() < deadline:
        if proc.poll() is not None:
            run["status"] = "failed"
            save_run(run)
            print(open(LOG_FILE, errors="replace").read()[-3000:])
            die("llama-server exited with %d" % proc.returncode)
        try:
            urllib.request.urlopen(url + "/health", timeout=1).read()
            break
        except Exception:
            time.sleep(1)
    else:
        die("timed out waiting for llama-server; see %s" % LOG_FILE)
    # what llama.cpp actually placed where
    text = open(LOG_FILE, errors="replace").read()
    for d in run["devices"]:
        m = re.search(r"load_tensors:\s+%s model buffer size\s*=\s*([\d.]+) MiB" % re.escape(d["device"]), text)
        if m:
            d["buffer_mb"] = int(float(m.group(1)))
    m = re.search(r"offloaded (\d+)/(\d+) layers", text)
    if m:
        run["offloaded"] = [int(m.group(1)), int(m.group(2))]
    for d in run["devices"]:
        if d.get("buffer_mb") is None and d.get("layers"):
            # current llama-server does not log per-device buffer sizes at default verbosity
            d["buffer_mb"] = int((d["layers"][1] - d["layers"][0]) * run["per_layer_mb"])
            d["buffer_estimated"] = True
    run["status"] = "running"
    save_run(run)
    print(C["g"] + "running" + C["0"] + "  http://%s:%d  (OpenAI-compatible: /v1/chat/completions)" % (cfg("HEAD", "head"), opts["port"]))
    print('  curl http://%s:%d/v1/chat/completions -d \'{"messages":[{"role":"user","content":"hi"}]}\'' % (cfg("HEAD", "head"), opts["port"]))


def cmd_stop():
    run = load_run()
    if not run or not run.get("pid"):
        print("nothing running")
        return
    pid = run["pid"]
    if alive(pid):
        os.killpg(os.getpgid(pid), signal.SIGTERM)
        for _ in range(30):
            if not alive(pid):
                break
            time.sleep(0.5)
        else:
            os.killpg(os.getpgid(pid), signal.SIGKILL)
    run["status"] = "stopped"
    run["stopped"] = time.time()
    save_run(run)
    print("stopped")


def cmd_status():
    run = load_run()
    if run:
        print("%s  status=%s  pid=%s  port=%s" % (run["model"], run.get("status"), run.get("pid"), run.get("port")))
        print_plan(run)
    else:
        print("no run")
    try:
        st = get_json(CLUSTERD + "/api/state")
        if st.get("llama"):
            l = st["llama"]
            print("throughput: %.1f tok/s generation, %.0f tok/s prompt" % (l.get("gen_tps") or 0, l.get("prompt_tps") or 0))
    except Exception:
        pass


def cmd_nodes():
    try:
        nodes = get_json(CLUSTERD + "/api/nodes")
    except Exception as e:
        die("clusterd not reachable (%s)" % e)
    print("  %-18s %-7s %-6s %-6s %-7s %-10s %-10s %-6s %s" % ("node", "role", "state", "link", "gpu", "free ram", "offers", "temp", "rpc"))
    for n in nodes:
        g = n.get("gpu") or {}
        print("  %-18s %-7s %-6s %-6s %-7s %-10s %-10s %-6s %s" % (
            n["name"], n.get("role"), "awake" if n.get("awake") else "asleep", n.get("link"), g.get("kind", "cpu"),
            gb((n.get("mem") or {}).get("free_mb")), gb(offered_mb(n)),
            "%s°C" % n["temp_c"] if n.get("temp_c") is not None else "-",
            "local" if n.get("role") == "head" else ("up" if (n.get("rpc") or {}).get("listening") else "down")))


# ---------------------------------------------------------------------------
# one controller: ssh to every device with the head's key
# ---------------------------------------------------------------------------
def ssh_target(n):
    """(user, host, port) for a node, or None when it cannot be reached over ssh."""
    host = n.get("lan_ip") or n.get("remote_ip")
    if not host:
        return None
    if n.get("os") == "android":
        return ("termux", host, 8022)        # Termux sshd ignores the username
    if n.get("os") == "windows":
        return None
    return ("root", host, 22)


def ssh_cmd(n, cmd, tty=False):
    t = ssh_target(n)
    if not t:
        return None
    user, host, port = t
    base = ["ssh", "-i", cfg("SSH_KEY", "/etc/home-cluster/id_ed25519"), "-o", "BatchMode=yes",
            "-o", "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=6", "-p", str(port)]
    if tty:
        base.append("-t")
    return base + ["%s@%s" % (user, host)] + ([cmd] if cmd else [])


def pick_nodes(sel):
    nodes = get_json(CLUSTERD + "/api/nodes")
    if sel == "--all":
        return [n for n in nodes if n.get("role") != "head"]
    m = [n for n in nodes if n["name"] == sel]
    if not m:
        die("unknown node %s (cluster nodes lists them)" % sel)
    return m


def cmd_exec(args):
    if len(args) < 3 or args[1] != "--":
        die("usage: cluster exec NODE|--all -- COMMAND ...")
    cmd = " ".join(args[2:])
    import concurrent.futures
    nodes = pick_nodes(args[0])

    def one(n):
        c = ssh_cmd(n, cmd)
        if not c:
            return n["name"], 1, "no ssh route (Windows workers are not reachable this way)\n"
        if not n.get("awake"):
            return n["name"], 1, "asleep (last seen %d s ago)\n" % n.get("age_s", 0)
        r = subprocess.run(c, capture_output=True, text=True, timeout=120)
        return n["name"], r.returncode, r.stdout + r.stderr

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        for name, rc, out in ex.map(one, nodes):
            col = C["g"] if rc == 0 else C["r"]
            print(col + "── %s (exit %d)" % (name, rc) + C["0"])
            print(out.rstrip() or "(no output)")


def cmd_restart(args):
    sel = args[0] if args else "--all"
    nodes = pick_nodes(sel)
    for n in nodes:
        cmd = "sv restart rpc-server cluster-agent" if n.get("os") == "android" else "systemctl restart rpc-server cluster-agent"
        c = ssh_cmd(n, cmd)
        if not c:
            print(C["y"] + "  %s: restart it on the PC (Get-ScheduledTask 'home-cluster*' | Start-ScheduledTask)" % n["name"] + C["0"])
            continue
        r = subprocess.run(c, capture_output=True, text=True, timeout=60)
        print(("  %s: " % n["name"]) + (C["g"] + "restarted" + C["0"] if r.returncode == 0 else C["r"] + "failed: " + (r.stderr.strip() or r.stdout.strip()) + C["0"]))


def cmd_ssh(args):
    if not args:
        die("usage: cluster ssh NODE")
    n = pick_nodes(args[0])[0]
    c = ssh_cmd(n, None, tty=True)
    if not c:
        die("%s is not reachable over ssh" % n["name"])
    os.execvp(c[0], c)


def cmd_share(args):
    """Dashboard (8787) and Open WebUI (30080) through Tailscale Serve, or publicly via Funnel."""
    mode = args[0] if args else "tailnet"
    ts = ["tailscale"]
    if mode == "off":
        subprocess.run(ts + ["serve", "reset"]); subprocess.run(ts + ["funnel", "reset"], capture_output=True)
        print("sharing off")
        return
    public = mode == "--public"
    if public:
        print(C["y"] + "public: Open WebUI will be reachable from the internet on your tailnet's *.ts.net name, behind its own login."
              " The dashboard and the model API stay tailnet-only; rpc-server never leaves the LAN." + C["0"])
    r = subprocess.run(ts + ["serve", "--bg", "--https=8443", "http://127.0.0.1:%s" % cfg("CLUSTERD_PORT", "8787")], capture_output=True, text=True)
    if r.returncode:
        die("tailscale serve failed: %s (is Tailscale up? run `tailscale up --ssh`)" % (r.stderr.strip() or r.stdout.strip()))
    subprocess.run((ts + ["funnel", "--bg", "--https=443", "http://127.0.0.1:30080"]) if public else
                   (ts + ["serve", "--bg", "--https=443", "http://127.0.0.1:30080"]), capture_output=True)
    name = subprocess.run(ts + ["status", "--self", "--json"], capture_output=True, text=True).stdout
    try:
        name = json.loads(name)["Self"]["DNSName"].rstrip(".")
    except Exception:
        name = "<this-machine>.<tailnet>.ts.net"
    print("dashboard:  https://%s:8443   (tailnet only)" % name)
    print("Open WebUI: https://%s        (%s)" % (name, "PUBLIC via Tailscale Funnel" if public else "tailnet only"))


def cmd_tune(args):
    t = load_tuning()
    if args:
        for a in args:
            if "=" not in a:
                die("usage: cluster tune KEY=VALUE ...")
            k, v = a.split("=", 1)
            k = k.upper()
            if k not in TUNING:
                die("unknown setting %s (cluster tune lists them)" % k)
            t[k] = v
        os.makedirs(os.path.dirname(TUNING_FILE), exist_ok=True)
        with open(TUNING_FILE, "w") as f:
            f.write("# home-cluster tuning — edit with `cluster tune KEY=VALUE`; applied by `cluster run`\n")
            for k in TUNING:
                f.write("%s=%s\n" % (k, t[k]))
        print("saved to %s (takes effect on the next cluster run)" % TUNING_FILE)
    print("  %-15s %-8s %s" % ("setting", "value", "meaning"))
    for k, (d, h) in TUNING.items():
        mark = "" if t[k] == d else C["y"] + " *" + C["0"]
        print("  %-15s %-8s %s%s" % (k, t[k], h, mark))


def probe_link(n, mb=8):
    """RTT to the rpc port and upload bandwidth to the agent, from the head."""
    import socket
    host, port = n.get("lan_ip"), (n.get("rpc") or {}).get("port")
    rtts = []
    for _ in range(3):
        t0 = time.time()
        try:
            with socket.create_connection((host, int(port)), timeout=2):
                rtts.append((time.time() - t0) * 1000)
        except (OSError, ValueError, TypeError):
            pass
    out = {"rtt_ms": round(min(rtts), 2) if rtts else None, "bw_mbps": None}
    if n.get("agent_port"):
        data = b"\0" * (mb << 20)
        t0 = time.time()
        try:
            req = urllib.request.Request("http://%s:%s/sink" % (host, n["agent_port"]), data=data,
                                         headers={"Content-Type": "application/octet-stream"})
            urllib.request.urlopen(req, timeout=30).read()
            out["bw_mbps"] = round(mb * 8 / (time.time() - t0), 1)
        except Exception:
            pass
    return out


def bench_device(model, rpc=None, ngl=99):
    """tok/s with the whole small model on one device (over RPC when rpc is given)."""
    exe = os.path.join(LLAMA_BIN, "llama-bench")
    cmd = [exe, "-m", model, "-ngl", str(ngl), "-p", "128", "-n", "32", "-r", "2", "-o", "json"]
    if rpc:
        cmd += ["--rpc", rpc]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        rows = json.loads(r.stdout[r.stdout.index("["):])
    except Exception as e:
        return {"error": str(e)[:200]}
    out = {}
    for row in rows:
        if row.get("n_prompt"):
            out["pp_tps"] = round(row.get("avg_ts", 0), 1)
        if row.get("n_gen"):
            out["tg_tps"] = round(row.get("avg_ts", 0), 1)
    return out


def cmd_bench(args):
    model, sel = None, "--all"
    it = iter(args)
    for a in it:
        if a == "--model":
            model = next(it)
        else:
            sel = a
    if not model:
        ggufs = sorted((os.path.getsize(os.path.join(MODELS, f)), f) for f in os.listdir(MODELS) if f.endswith(".gguf")) if os.path.isdir(MODELS) else []
        if not ggufs:
            die("no model: put a small GGUF (0.5B-1B) in %s or pass --model" % MODELS)
        model = os.path.join(MODELS, ggufs[0][1])
        if ggufs[0][0] > 3 * 2**30:
            print(C["y"] + "benchmarking with a %s model is slow; a 0.5B-1B GGUF is enough" % gb(ggufs[0][0] >> 20) + C["0"])
    elif not os.path.exists(model) and os.path.exists(os.path.join(MODELS, model)):
        model = os.path.join(MODELS, model)
    nodes = get_json(CLUSTERD + "/api/nodes")
    bench = load_bench()
    targets = [n for n in nodes if n.get("awake") and (sel == "--all" or n["name"] == sel)]
    if not targets:
        die("nothing awake to benchmark")
    print("benchmark model: %s" % os.path.basename(model))
    print("  %-18s %-8s %-10s %-10s %-9s %-10s" % ("node", "link", "gen tok/s", "prompt t/s", "rtt ms", "bw Mbit/s"))
    for n in targets:
        name = n["name"]
        if n.get("role") == "head":
            res = bench_device(model, None, 99 if cfg("GPU", "cpu") != "cpu" else 0)
            link = {"rtt_ms": 0, "bw_mbps": None}
        else:
            if not (n.get("rpc") or {}).get("listening"):
                print("  %-18s rpc down, skipped" % name)
                continue
            link = probe_link(n)
            res = bench_device(model, "%s:%s" % (n["lan_ip"], n["rpc"]["port"]))
        entry = {**res, **link, "ts": time.time(), "model": os.path.basename(model), "link": n.get("link"), "gpu": (n.get("gpu") or {}).get("kind")}
        bench[name] = entry
        save_json_file(BENCH_FILE, bench)
        print("  %-18s %-8s %-10s %-10s %-9s %-10s %s" % (name, n.get("link"), entry.get("tg_tps", "-"), entry.get("pp_tps", "-"),
              entry.get("rtt_ms", "-"), entry.get("bw_mbps") or "-", C["r"] + entry["error"] + C["0"] if entry.get("error") else ""))
    measured = {k: v for k, v in bench.items() if v.get("tg_tps")}
    if len(measured) > 1:
        slow = min(measured, key=lambda k: measured[k]["tg_tps"])
        fast = max(measured, key=lambda k: measured[k]["tg_tps"])
        print(C["y"] + "slowest: %s (%.1f tok/s)" % (slow, measured[slow]["tg_tps"]) + C["0"] +
              "  fastest: %s (%.1f tok/s)" % (fast, measured[fast]["tg_tps"]))
        print("  the chain runs at the pace of its slowest device; the planner now orders devices by these numbers (ORDER=bench)")


def save_json_file(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        json.dump(data, f, indent=1)
    os.replace(path + ".tmp", path)


def cmd_top(args):
    nodes = get_json(CLUSTERD + "/api/nodes")
    sel = args[0] if args else None
    for n in nodes:
        if sel and n["name"] != sel:
            continue
        procs = n.get("processes") or []
        if n.get("agent_port") and n.get("awake"):
            try:
                procs = get_json("http://%s:%s/processes" % (n["lan_ip"], n["agent_port"]), timeout=3)[:12 if sel else 6]
            except Exception:
                pass
        print(C["b"] + n["name"] + C["0"] + "  %s · %s free of %s · load %s%s" % (
            "awake" if n.get("awake") else "asleep", gb((n.get("mem") or {}).get("free_mb")), gb((n.get("mem") or {}).get("total_mb")),
            n.get("load1"), ("  " + C["y"] + "⚠ " + "; ".join(n["alerts"]) + C["0"]) if n.get("alerts") else ""))
        if not procs:
            print("  (no process data: heartbeat-only agent)")
            continue
        print("  %-7s %-24s %10s %7s" % ("pid", "process", "rss", "cpu%"))
        for p in procs:
            tag = C["d"] if p.get("cluster") else ""
            print("  %s%-7d %-24s %10s %7s%s" % (tag, p["pid"], p["name"], gb(p["rss_mb"]), p["cpu_pct"] if p.get("cpu_pct") is not None else "-", C["0"] if tag else ""))
    if not sel:
        print(C["d"] + "cluster top NODE for more; cluster kill NODE PID; cluster ssh NODE for a shell" + C["0"])


def cmd_kill(args):
    if len(args) != 2 or not args[1].isdigit():
        die("usage: cluster kill NODE PID")
    n = pick_nodes(args[0])[0]
    c = ssh_cmd(n, "kill %s" % args[1])
    if not c:
        die("%s is not reachable over ssh" % n["name"])
    r = subprocess.run(c, capture_output=True, text=True, timeout=30)
    print("killed" if r.returncode == 0 else "failed: " + (r.stderr.strip() or r.stdout.strip()))


def cmd_models():
    try:
        nodes = get_json(CLUSTERD + "/api/nodes")
        pool = sum(offered_mb(n) for n in nodes if n.get("awake") and (n.get("role") == "head" or (n.get("rpc") or {}).get("listening")))
    except Exception:
        pool = None
    files = sorted(f for f in os.listdir(MODELS) if f.endswith(".gguf")) if os.path.isdir(MODELS) else []
    if not files:
        print("no .gguf files in %s" % MODELS)
        return
    print("  %-50s %-10s %-7s %s" % ("model", "size", "layers", "fits now?" if pool is not None else ""))
    for f in files:
        try:
            i = read_gguf(os.path.join(MODELS, f))
            fit = "" if pool is None else ("yes" if i["size_mb"] * 1.15 < pool else "no (~%s needed, %s pooled)" % (gb(int(i["size_mb"] * 1.15)), gb(pool)))
            print("  %-50s %-10s %-7d %s" % (f[:50], gb(i["size_mb"]), i["n_layer"], fit))
        except SystemExit:
            print("  %-50s (unreadable)" % f[:50])


def cmd_ui(args):
    k8s = cfg("K8S_DIR", "/opt/home-cluster/k8s")
    manifest = os.path.join(k8s, "open-webui.yaml")
    if not os.path.exists(manifest):
        die("%s not found; re-run head.sh" % manifest)
    url = "http://%s:%d" % (cfg("HEAD", "head"), int(cfg("LLAMA_PORT", "8080")))
    text = open(manifest).read().replace("__LLAMA_URL__", url + "/v1")
    if args and args[0] == "stop":
        subprocess.run(["kubectl", "delete", "-f", "-"], input=text, text=True)
        return
    r = subprocess.run(["kubectl", "apply", "-f", "-"], input=text, text=True)
    if r.returncode:
        die("kubectl apply failed; is k3s running on the head?")
    print(C["g"] + "Open WebUI" + C["0"] + " will be at http://%s:30080 once the image is pulled (kubectl -n home-cluster get pods)" % cfg("HEAD", "head"))
    print("  it talks to llama-server at %s" % url)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "nodes":
        cmd_nodes()
    elif cmd == "run":
        cmd_run(args)
    elif cmd == "plan":
        cmd_run(args, dry=True)
    elif cmd == "stop":
        cmd_stop()
    elif cmd == "status":
        cmd_status()
    elif cmd == "ui":
        cmd_ui(args)
    elif cmd == "exec":
        cmd_exec(args)
    elif cmd == "restart":
        cmd_restart(args)
    elif cmd == "ssh":
        cmd_ssh(args)
    elif cmd == "top":
        cmd_top(args)
    elif cmd == "kill":
        cmd_kill(args)
    elif cmd == "share":
        cmd_share(args)
    elif cmd == "bench":
        cmd_bench(args)
    elif cmd == "tune":
        cmd_tune(args)
    elif cmd == "models":
        cmd_models()
    elif cmd == "logs":
        os.execvp("tail", ["tail", "-n", "100"] + (["-f"] if "-f" in args else []) + [LOG_FILE])
    else:
        die("unknown command %s (see --help)" % cmd)


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # `cluster ... | head` must not traceback
    main(sys.argv[1:])
